{
  "id": "anesthesia_preop_outpatient",
  "title": "麻酔科術前外来",
  "description": "同一患者の術前評価に必要な情報だけを集約したシナリオ。",
  "patient_context_key": "header_patient_identity",
  "tasks": [
    {
      "id": "task_1",
      "title": "患者情報の確認",
      "description": "患者基本情報、生活歴・アレルギー、既往歴・治療内容、麻酔歴を続けて確認する。",
      "order": 1,
      "widgets": [
        {
          "id": "widget_1",
          "title": "患者基本情報と生活歴・アレルギー",
          "widget": {
            "widget_type": "columns",
            "columns": [
              [
                {
                  "widget_type": "markdown",
                  "body": "### 患者基本情報"
                },
                {
                  "widget_type": "markdown",
                  "data_key": "md_t1_patient_profile"
                }
              ],
              [
                {
                  "widget_type": "markdown",
                  "body": "### 生活歴・アレルギー"
                },
                {
                  "widget_type": "markdown",
                  "data_key": "md_t1_lifestyle_allergy"
                }
              ]
            ],
            "widths": [
              1,
              1
            ],
            "gap": "medium"
          },
          "data_nodes": [
            {
              "id": "data_0",
              "context_key": "header_patient_identity",
              "model_name": null,
              "data_type": "scalar",
              "description": "患者識別情報",
              "primary_fields": [
                "患者表示"
              ],
              "sql": "SELECT COALESCE(pb.\"患者氏名\", '氏名未登録') || ' / ' || CASE WHEN pb.\"現在年齢\" IS NULL THEN '年齢不明' ELSE printf('%g', pb.\"現在年齢\") END || '歳 / ' || COALESCE(pb.\"性別\", '性別不明') || ' / ID ' || pb.\"患者ID\" AS \"患者表示\" FROM \"患者基本\" pb WHERE pb.\"患者ID\"='ITO_PREOP_001' LIMIT 1"
            },
            {
              "id": "data_1",
              "context_key": "md_t1_patient_profile",
              "model_name": null,
              "data_type": "scalar",
              "description": "患者基本情報の要約",
              "primary_fields": [
                "summary_markdown"
              ],
              "sql": "SELECT '- 患者ID: ' || pb.\"患者ID\" || char(10) || '- 匿名ID: ' || pb.\"匿名ID\" || char(10) || '- 年齢: ' || CASE WHEN pb.\"現在年齢\" IS NULL THEN '-' ELSE printf('%g', pb.\"現在年齢\") END || char(10) || '- 性別: ' || COALESCE(pb.\"性別\", '-') || char(10) || '- 身長: ' || CASE WHEN pp.\"身長\" IS NULL THEN '-' ELSE printf('%g', pp.\"身長\") END || ' cm' || char(10) || '- 体重: ' || CASE WHEN pp.\"体重\" IS NULL THEN '-' ELSE printf('%g', pp.\"体重\") END || ' kg' || char(10) || '- BMI: ' || COALESCE(CAST(ROUND(CASE WHEN pp.\"身長\" IS NULL OR pp.\"身長\"=0 THEN NULL ELSE pp.\"体重\"/((pp.\"身長\"/100.0)*(pp.\"身長\"/100.0)) END, 1) AS TEXT), '-') AS \"summary_markdown\" FROM \"患者基本\" pb LEFT JOIN \"患者プロフィール\" pp ON pb.\"患者ID\"=pp.\"患者ID\" WHERE pb.\"患者ID\"='ITO_PREOP_001' LIMIT 1"
            },
            {
              "id": "data_2",
              "context_key": "md_t1_lifestyle_allergy",
              "model_name": null,
              "data_type": "scalar",
              "description": "生活歴とアレルギーの要約",
              "primary_fields": [
                "summary_markdown"
              ],
              "sql": "SELECT '- 喫煙歴: ' || COALESCE(pp.\"喫煙\", '-') || char(10) || '- 喫煙開始年齢: ' || CASE WHEN pp.\"喫煙開始年齢\" IS NULL THEN '-' ELSE printf('%g', pp.\"喫煙開始年齢\") END || char(10) || '- 喫煙中止年齢: ' || CASE WHEN pp.\"喫煙中止年齢\" IS NULL THEN '-' ELSE printf('%g', pp.\"喫煙中止年齢\") END || char(10) || '- 飲酒歴: ' || COALESCE(pp.\"飲酒\", '-') || char(10) || '- アレルギー: ' || COALESCE(pa.\"アレルギー名称\", '-') || char(10) || '- アレルギー症状: ' || COALESCE(pa.\"症状\", '-') || char(10) || '- コメント: ' || COALESCE(pa.\"フリーコメント\", '-') AS \"summary_markdown\" FROM \"患者基本\" pb LEFT JOIN \"患者プロフィール\" pp ON pb.\"患者ID\"=pp.\"患者ID\" LEFT JOIN \"患者アレルギー情報\" pa ON pb.\"患者ID\"=pa.\"患者ID\" WHERE pb.\"患者ID\"='ITO_PREOP_001' ORDER BY COALESCE(pa.\"検索日(診断日)\", pa.\"入力日\") DESC LIMIT 1"
            }
          ]
        },
        {
          "id": "widget_2",
          "title": null,
          "widget": {
            "widget_type": "markdown",
            "body": "---\n### 既往歴と治療内容の確認"
          },
          "data_nodes": []
        },
        {
          "id": "widget_3",
          "title": "既往歴",
          "widget": {
            "widget_type": "dataframe",
            "data_key": "table_t1_history",
            "column_order": [
              "既往歴",
              "治療法",
              "手術",
              "輸血",
              "開始日"
            ],
            "height": 220
          },
          "data_nodes": [
            {
              "id": "data_3",
              "context_key": "table_t1_history",
              "model_name": null,
              "data_type": "dataframe",
              "description": "既往歴（該当患者）",
              "primary_fields": [
                "既往歴",
                "治療法",
                "手術",
                "輸血",
                "開始日"
              ],
              "sql": "SELECT \"既往歴(病名)\" AS \"既往歴\", \"治療法\", \"手術の有無\" AS \"手術\", \"輸血の有無\" AS \"輸血\", \"病名開始日\" AS \"開始日\" FROM \"問診票病歴\" WHERE \"患者ID\"='ITO_PREOP_001' ORDER BY \"検索日(発病日)\" DESC"
            }
          ]
        },
        {
          "id": "widget_4",
          "title": "処方内容",
          "widget": {
            "widget_type": "dataframe",
            "data_key": "table_t1_prescriptions",
            "column_order": [
              "開始日",
              "薬剤名",
              "一日量",
              "用法"
            ],
            "height": 220
          },
          "data_nodes": [
            {
              "id": "data_4",
              "context_key": "table_t1_prescriptions",
              "model_name": null,
              "data_type": "dataframe",
              "description": "治療内容（処方、該当患者）",
              "primary_fields": [
                "開始日",
                "薬剤名",
                "一日量",
                "用法"
              ],
              "sql": "SELECT \"服薬開始日\" AS \"開始日\", \"薬剤名\", CASE WHEN \"一日量\" IS NULL THEN '-' ELSE printf('%g', \"一日量\") END || COALESCE(\"一日量単位\", '') AS \"一日量\", \"用法\" FROM \"処方\" WHERE \"患者ID\"='ITO_PREOP_001' ORDER BY \"服薬開始日\" DESC"
            }
          ]
        },
        {
          "id": "widget_5",
          "title": null,
          "widget": {
            "widget_type": "markdown",
            "body": "---\n### 麻酔歴の確認"
          },
          "data_nodes": []
        },
        {
          "id": "widget_6",
          "title": "麻酔歴",
          "widget": {
            "widget_type": "dataframe",
            "data_key": "table_t1_anesthesia_history",
            "column_order": [
              "手術日",
              "術式",
              "麻酔科医",
              "麻酔時間(分)",
              "麻酔開始",
              "麻酔終了"
            ],
            "height": 220
          },
          "data_nodes": [
            {
              "id": "data_5",
              "context_key": "table_t1_anesthesia_history",
              "model_name": null,
              "data_type": "dataframe",
              "description": "麻酔歴（該当患者）",
              "primary_fields": [
                "手術日",
                "術式",
                "麻酔科医",
                "麻酔時間(分)",
                "麻酔開始",
                "麻酔終了"
              ],
              "sql": "SELECT \"検索日(手術実施日)\" AS \"手術日\", \"実施術式1\" AS \"術式\", \"麻酔科医1\" AS \"麻酔科医\", \"麻酔時間(分)\", \"麻酔開始日時\" AS \"麻酔開始\", \"麻酔終了日時\" AS \"麻酔終了\" FROM \"手術実施\" WHERE \"患者ID\"='ITO_PREOP_001' ORDER BY \"検索日(手術実施日)\" DESC"
            }
          ]
        }
      ]
    },
    {
      "id": "task_2",
      "title": "手術の確認",
      "description": "該当患者の手術依頼情報を確認する。",
      "order": 2,
      "widgets": [
        {
          "id": "widget_7",
          "title": "手術情報",
          "widget": {
            "widget_type": "dataframe",
            "data_key": "table_t2_surgery_request",
            "column_order": [
              "予定日",
              "依頼診療科",
              "依頼病名",
              "術式",
              "予定時間(分)",
              "体位",
              "麻酔科依頼"
            ],
            "height": 220
          },
          "data_nodes": [
            {
              "id": "data_6",
              "context_key": "table_t2_surgery_request",
              "model_name": null,
              "data_type": "dataframe",
              "description": "手術依頼情報（該当患者）",
              "primary_fields": [
                "予定日",
                "依頼診療科",
                "依頼病名",
                "術式",
                "予定時間(分)",
                "体位",
                "麻酔科依頼"
              ],
              "sql": "SELECT \"検索日(手術予定日)\" AS \"予定日\", \"診療科\" AS \"依頼診療科\", \"依頼病名\", \"申込術式1\" AS \"術式\", \"予定手術所要時間(分)\" AS \"予定時間(分)\", \"予定体位1\" AS \"体位\", \"麻酔科依頼の有無\" AS \"麻酔科依頼\" FROM \"手術依頼\" WHERE \"患者ID\"='ITO_PREOP_001' ORDER BY \"検索日(手術予定日)\" DESC"
            }
          ]
        }
      ]
    },
    {
      "id": "task_3",
      "title": "検査結果の確認",
      "description": "最新の検査値を一覧し、単位と尺度を考慮した項目別グラフで推移を確認する。",
      "order": 3,
      "widgets": [
        {
          "id": "widget_8",
          "title": null,
          "widget": {
            "widget_type": "markdown",
            "body": "### 最新検査値"
          },
          "data_nodes": []
        },
        {
          "id": "widget_9",
          "title": "最新検査値一覧",
          "widget": {
            "widget_type": "dataframe",
            "data_key": "table_t3_latest_labs",
            "column_order": [
              "区分",
              "検査項目",
              "最新値",
              "検査日"
            ],
            "height": 350
          },
          "data_nodes": [
            {
              "id": "data_7",
              "context_key": "table_t3_latest_labs",
              "model_name": null,
              "data_type": "dataframe",
              "description": "術前評価で確認する主要検査項目の最新値",
              "primary_fields": [
                "区分",
                "検査項目",
                "最新値",
                "検査日"
              ],
              "sql": "WITH ranked AS (SELECT \"検査項目\", \"結果(数値)\" AS \"最新値\", COALESCE(NULLIF(\"結果値単位\", ''), CASE \"検査項目\" WHEN 'Hb' THEN 'g/dL' WHEN 'WBC' THEN '×10³/μL' WHEN 'Plt' THEN '×10⁴/μL' WHEN 'Cr' THEN 'mg/dL' WHEN 'eGFR' THEN 'mL/min/1.73m²' WHEN 'K' THEN 'mEq/L' WHEN 'AST' THEN 'U/L' WHEN 'ALT' THEN 'U/L' END) AS \"単位\", \"報告日\" AS \"検査日\", ROW_NUMBER() OVER (PARTITION BY \"検査項目\" ORDER BY \"報告日\" DESC, COALESCE(\"報告時刻\", '') DESC, \"ROW_ID\" DESC) AS rn FROM \"検体検査結果\" WHERE \"患者ID\"='ITO_PREOP_001' AND \"検査項目\" IN ('Hb','WBC','Plt','Cr','eGFR','K','AST','ALT')) SELECT CASE WHEN \"検査項目\" IN ('Hb','WBC','Plt') THEN '血算' WHEN \"検査項目\" IN ('Cr','eGFR') THEN '腎機能' WHEN \"検査項目\"='K' THEN '電解質' ELSE '肝細胞障害指標' END AS \"区分\", \"検査項目\", CAST(\"最新値\" AS TEXT) || ' ' || \"単位\" AS \"最新値\", \"検査日\" FROM ranked WHERE rn=1 ORDER BY CASE \"検査項目\" WHEN 'Hb' THEN 1 WHEN 'WBC' THEN 2 WHEN 'Plt' THEN 3 WHEN 'Cr' THEN 4 WHEN 'eGFR' THEN 5 WHEN 'K' THEN 6 WHEN 'AST' THEN 7 WHEN 'ALT' THEN 8 END"
            }
          ]
        },
        {
          "id": "widget_10",
          "title": null,
          "widget": {
            "widget_type": "markdown",
            "body": "### 検査値推移\n血算と腎機能・電解質は単位・尺度が異なるため個別表示し、同じ単位で比較できるAST・ALTのみ同一グラフに表示します。"
          },
          "data_nodes": []
        },
        {
          "id": "widget_11",
          "title": "血算推移",
          "widget": {
            "widget_type": "columns",
            "columns": [
              [
                {
                  "widget_type": "markdown",
                  "body": "#### Hb"
                },
                {
                  "widget_type": "line_chart",
                  "data_key": "chart_t3_cbc",
                  "x": "検査日",
                  "y": "Hb",
                  "x_label": "検査日",
                  "y_label": "Hb (g/dL)"
                }
              ],
              [
                {
                  "widget_type": "markdown",
                  "body": "#### WBC"
                },
                {
                  "widget_type": "line_chart",
                  "data_key": "chart_t3_cbc",
                  "x": "検査日",
                  "y": "WBC",
                  "x_label": "検査日",
                  "y_label": "WBC (×10³/μL)"
                }
              ],
              [
                {
                  "widget_type": "markdown",
                  "body": "#### Plt"
                },
                {
                  "widget_type": "line_chart",
                  "data_key": "chart_t3_cbc",
                  "x": "検査日",
                  "y": "Plt",
                  "x_label": "検査日",
                  "y_label": "Plt (×10⁴/μL)"
                }
              ]
            ],
            "widths": [
              1,
              1,
              1
            ],
            "gap": "small"
          },
          "data_nodes": [
            {
              "id": "data_8",
              "context_key": "chart_t3_cbc",
              "model_name": null,
              "data_type": "dataframe",
              "description": "血算推移（Hb、WBC、Pltを単位別に個別描画）",
              "primary_fields": [
                "検査日",
                "Hb",
                "WBC",
                "Plt"
              ],
              "sql": "SELECT \"報告日\" AS \"検査日\", MAX(CASE WHEN \"検査項目\"='Hb' THEN \"結果(数値)\" END) AS \"Hb\", MAX(CASE WHEN \"検査項目\"='WBC' THEN \"結果(数値)\" END) AS \"WBC\", MAX(CASE WHEN \"検査項目\"='Plt' THEN \"結果(数値)\" END) AS \"Plt\" FROM \"検体検査結果\" WHERE \"患者ID\"='ITO_PREOP_001' AND \"検査項目\" IN ('Hb', 'WBC', 'Plt') GROUP BY \"報告日\" ORDER BY \"報告日\""
            }
          ]
        },
        {
          "id": "widget_12",
          "title": "腎機能・電解質推移",
          "widget": {
            "widget_type": "columns",
            "columns": [
              [
                {
                  "widget_type": "markdown",
                  "body": "#### Cr"
                },
                {
                  "widget_type": "line_chart",
                  "data_key": "chart_t3_renal",
                  "x": "検査日",
                  "y": "Cr",
                  "x_label": "検査日",
                  "y_label": "Cr (mg/dL)"
                }
              ],
              [
                {
                  "widget_type": "markdown",
                  "body": "#### eGFR"
                },
                {
                  "widget_type": "line_chart",
                  "data_key": "chart_t3_renal",
                  "x": "検査日",
                  "y": "eGFR",
                  "x_label": "検査日",
                  "y_label": "eGFR (mL/min/1.73m²)"
                }
              ],
              [
                {
                  "widget_type": "markdown",
                  "body": "#### K"
                },
                {
                  "widget_type": "line_chart",
                  "data_key": "chart_t3_renal",
                  "x": "検査日",
                  "y": "K",
                  "x_label": "検査日",
                  "y_label": "K (mEq/L)"
                }
              ]
            ],
            "widths": [
              1,
              1,
              1
            ],
            "gap": "small"
          },
          "data_nodes": [
            {
              "id": "data_9",
              "context_key": "chart_t3_renal",
              "model_name": null,
              "data_type": "dataframe",
              "description": "腎機能・電解質推移（Cr、eGFR、Kを単位・尺度別に個別描画）",
              "primary_fields": [
                "検査日",
                "Cr",
                "eGFR",
                "K"
              ],
              "sql": "SELECT \"報告日\" AS \"検査日\", MAX(CASE WHEN \"検査項目\"='Cr' THEN \"結果(数値)\" END) AS \"Cr\", MAX(CASE WHEN \"検査項目\"='eGFR' THEN \"結果(数値)\" END) AS \"eGFR\", MAX(CASE WHEN \"検査項目\"='K' THEN \"結果(数値)\" END) AS \"K\" FROM \"検体検査結果\" WHERE \"患者ID\"='ITO_PREOP_001' AND \"検査項目\" IN ('Cr', 'eGFR', 'K') GROUP BY \"報告日\" ORDER BY \"報告日\""
            }
          ]
        },
        {
          "id": "widget_13",
          "title": "AST・ALT推移",
          "widget": {
            "widget_type": "line_chart",
            "data_key": "chart_t3_liver",
            "x": "検査日",
            "y": [
              "AST",
              "ALT"
            ],
            "x_label": "検査日",
            "y_label": "AST・ALT (U/L)"
          },
          "data_nodes": [
            {
              "id": "data_10",
              "context_key": "chart_t3_liver",
              "model_name": null,
              "data_type": "dataframe",
              "description": "肝細胞障害指標の推移（同じ単位のAST、ALT）",
              "primary_fields": [
                "検査日",
                "AST",
                "ALT"
              ],
              "sql": "SELECT \"報告日\" AS \"検査日\", MAX(CASE WHEN \"検査項目\"='AST' THEN \"結果(数値)\" END) AS \"AST\", MAX(CASE WHEN \"検査項目\"='ALT' THEN \"結果(数値)\" END) AS \"ALT\" FROM \"検体検査結果\" WHERE \"患者ID\"='ITO_PREOP_001' AND \"検査項目\" IN ('AST', 'ALT') GROUP BY \"報告日\" ORDER BY \"報告日\""
            }
          ]
        }
      ]
    }
  ]
}
