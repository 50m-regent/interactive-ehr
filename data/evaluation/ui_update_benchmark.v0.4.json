  "safety_policy": {
    "id": "structural-safety-policy-v0.4",
    "forbidden_display_fields": ["patient_name"],
    "approved_source_tables": [
      "patient_info",
      "surgery_orders",
      "lifestyle_records",
      "history_records",
      "lab_results",
      "anesthesia_records",
      "risk_summary",
      "patient_summary",
      "surgical_registry",
      "integrated_history",
      "diagnostic_results",
      "anesthesia_archive"
    ],
    "source_reference": "data/evaluation/ito_clinical_tasks.v1.json",
    "review_status": "draft",
    "interpretation": "合成患者ID以外の直接識別子を表示せず、事前登録した合成データソースだけを参照する。"
  },
  "requirements": [
    {
      "id": "R1_update_scope",
      "description": "更新対象に指定されていない成果物またはノードを変更しない。",
      "runtime_comparable": true,
      "direct_expression": "変更前後の成果物ID単位の差分を許可対象と照合する。",
      "graph_expression": "変更前後のノードID単位の差分を許可対象と照合する。",
      "direct_implementation": ["_validate_direct_scope"],
      "graph_implementation": ["_validate_graph_scope"],
      "referenced_artifacts": ["UpdateCase.intent", "ArtifactState", "GraphState"],
      "maintenance_touchpoints": ["許可対象の定義", "直接差分検査", "グラフ差分検査"],
      "tests": ["test_each_single_fault_is_caught_by_its_control"]
    },
    {
      "id": "R2_structural_safety",
      "description": "禁止表示項目と未承認データソースを受理しない。",
      "runtime_comparable": true,
      "direct_expression": "成果物の表示項目とクエリ元を共通ポリシーへ照合する。",
      "graph_expression": "グラフからコンパイルした成果物を同じ共通ポリシーへ照合する。",
      "direct_implementation": ["_validate_artifact_safety"],
      "graph_implementation": ["_validate_artifact_safety"],
      "referenced_artifacts": ["SafetyPolicy", "WidgetArtifact", "QueryArtifact"],
      "maintenance_touchpoints": ["安全ポリシー", "共通安全検査"],
      "tests": ["test_each_single_fault_is_caught_by_its_control"]
    },
    {
      "id": "R3_display_data_trace",
      "description": "表示項目が対応するデータ取得項目まで追跡できる。",
      "runtime_comparable": true,
      "direct_expression": "Widgetのquery_idと選択列を突き合わせる。",
      "graph_expression": "WidgetNodeからDataNodeへの辺と選択列をたどる。",
      "direct_implementation": ["_validate_artifact_trace"],
      "graph_implementation": ["_validate_graph_trace"],
      "referenced_artifacts": ["WidgetArtifact.query_id", "GraphWidgetNode.data_node_id"],
      "maintenance_touchpoints": ["直接成果物の参照検査", "グラフの辺検査"],
      "tests": ["test_each_single_fault_is_caught_by_its_control"]
    },
    {
      "id": "R4_query_execution",
      "description": "更新後の全クエリが事前登録した合成スキーマで実行できる。",
      "runtime_comparable": true,
      "direct_expression": "構造化クエリをSQLiteへコンパイルして実行する。",
      "graph_expression": "DataNodeを同じ構造化クエリへコンパイルして実行する。",
      "direct_implementation": ["_validate_queries_execute"],
      "graph_implementation": ["_validate_queries_execute"],
      "referenced_artifacts": ["QueryArtifact", "available_fields", "source_tables"],
      "maintenance_touchpoints": ["合成スキーマ", "SQLコンパイラ", "実行検査"],
      "tests": ["test_each_single_fault_is_caught_by_its_control"]
    },
    {
      "id": "E1_task_information_provenance",
      "description": "取得項目を診療タスク上の情報要件へ結び付ける。",
      "runtime_comparable": false,
      "direct_expression": "直接成果物だけでは保持できず、外部メタデータが必要になる。",
      "graph_expression": "DataNodeのinformation_idsとして表現する。",
      "direct_implementation": [],
      "graph_implementation": ["_validate_graph_provenance"],
      "referenced_artifacts": ["GraphDataNode.information_ids"],
      "maintenance_touchpoints": ["情報要件ID", "DataNode", "由来検査"],
      "tests": ["test_graph_provenance_is_recorded_outside_the_main_fault_model"]
    },
    {
      "id": "E2_evidence_review_state",
      "description": "更新要求と安全条件の根拠および確認状態を保持する。",
      "runtime_comparable": false,
      "direct_expression": "成果物の外にある文書または台帳が必要になる。",
      "graph_expression": "更新仕様と制約メタデータをグラフ関連資産から参照できる。",
      "direct_implementation": [],
      "graph_implementation": [],
      "referenced_artifacts": ["UpdateCase.source_reference", "SafetyPolicy.review_status"],
      "maintenance_touchpoints": ["臨床タスクモデル", "専門家確認状態", "更新要求"],
      "tests": ["test_benchmark_has_frozen_case_and_sequence_shape"]
    }
  ],
