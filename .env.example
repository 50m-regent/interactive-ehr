# Gemini API (Vertex AI) 設定
# サービスアカウントJSONファイルへのパス (必須)
GOOGLE_APPLICATION_CREDENTIALS=./key.json

# 以下はオプション (デフォルト値あり)
# GEMINI_PROJECT=gemini-api-project-464304
# GEMINI_LOCATION=asia-northeast1
# GEMINI_MODEL=gemini-2.5-pro

# --- 閉域ネットワーク向けプロキシモード ---
# GEMINI_PROXY_URL を設定すると、Vertex AI の代わりにベンダー提供の
# Gemini プロキシ経由で生成する (GOOGLE_APPLICATION_CREDENTIALS 不要)。
# GEMINI_PROXY_URL=http://192.168.197.130:3000/api/gemini
# GEMINI_MODEL=gemini-2.5-flash-lite    # プロキシモードのデフォルト
# GEMINI_PROXY_MAX_OUTPUT_TOKENS=8192
# GEMINI_PROXY_TEMPERATURE=0.2
# GEMINI_PROXY_TIMEOUT=300
